  "automaticUpdates": {
    "enabledByDefault": true,
    "intervalHours": 24,
    "timeoutMs": 1500,
    "defaultMode": "notify",
    "trigger": "Successful board render, asset import/freeze, job create or round prepare via package CLI. Polling/version/help remain offline.",
    "configuration": "PRODUCT_REFERENCE_REPLACEMENT_STATE_DIR optional user state directory; update status shows policy.",
    "disable": "PRODUCT_REFERENCE_REPLACEMENT_UPDATE_CHECK=0",
    "recovery": "Offline results cached for 24h; exclusive lock; preserve malformed user cache.",
    "installation": "explicit-only",
    "channel": "latest"
  },
  "platforms": {
    "host": "Any Agent satisfying declared capabilities; actual host discovery is verified by that host.",
    "os": "Node.js 22+; package tests run on macOS and Windows; host runtime evidence separate."
  },
  "boundary": "Application Skill owns visual choices and acceptance; package executes local deterministic work. Generation uses dynamically resolved sealseek-media.",
  "image_generation_route": {
    "package": "@petercjl/sealseek-media-cli",
    "command": "sealseek-media",
    "skill": "sealseek-media",
    "model": "nano-banana-pro",
    "exclusive": true,
    "native_image_generation_allowed": false,
    "direct_api_fallback_allowed": false,
    "dependency_failure": "Preserve task ID and report CAPABILITY_UNAVAILABLE or FEATURE_UNSUPPORTED; do not switch routes."
  },
  "installationLifecycle": {
    "agentNeutral": true,
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "install": "Read INSTALL.md, resolve the current host destination and registration mechanism; skill install --target-directory ABSOLUTE_SKILL_DIR; verify host discovery.",
    "update": "Read UPDATE.md; update install --target-directory ABSOLUTE_SKILL_DIR --yes; sync even at same version; refresh current host.",
    "verification": "Real CLI version plus managed/up_to_date canonical Skill hashes and host-verified discovery/load. File synchronization reports host-registration-pending.",
    "hostDirectoryDefaults": false
  }
}
